---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { profile, socials, education, experience } from '../data/portfolio';

export interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  bare?: boolean;
  breadcrumbs?: Crumb[];
}

const {
  title = `${profile.name} | Flutter Developer for Android Apps`,
  description = profile.description,
  noindex = false,
  bare = false,
  breadcrumbs = [{ name: 'Home', path: '/' }],
} = Astro.props;

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs('/og.png');
const ogAlt = `${profile.name}, Flutter developer. Sole mobile developer behind OctaNet, author of five research papers.`;
const portrait = await getImage({ src: profile.portrait, width: 800, format: 'jpg' });
const portraitUrl = abs(portrait.src);

const id = {
  person: abs('/#person'),
  website: abs('/#website'),
  service: abs('/#service'),
  page: `${canonical}#webpage`,
  breadcrumbs: `${canonical}#breadcrumbs`,
};

const address = {
  '@type': 'PostalAddress',
  addressLocality: 'Palghar',
  addressRegion: 'Maharashtra',
  addressCountry: 'IN',
};

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': id.website,
    url: abs('/'),
    name: profile.name,
    description: profile.description,
    inLanguage: 'en-IN',
    publisher: { '@id': id.person },
  },
  {
    '@type': noindex ? 'WebPage' : 'ProfilePage',
    '@id': id.page,
    url: canonical,
    name: title,
    description,
    inLanguage: 'en-IN',
    isPartOf: { '@id': id.website },
    breadcrumb: { '@id': id.breadcrumbs },
    ...(noindex ? {} : { mainEntity: { '@id': id.person }, primaryImageOfPage: ogImage }),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': id.breadcrumbs,
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.path),
    })),
  },
];

if (!bare) {
  graph.push(
    {
      '@type': 'Person',
      '@id': id.person,
      name: profile.fullName,
      alternateName: profile.name,
      jobTitle: 'Flutter Developer',
      description: profile.description,
      url: abs('/'),
      image: portraitUrl,
      email: `mailto:${profile.email}`,
      address,
      nationality: { '@type': 'Country', name: 'India' },
      worksFor: { '@type': 'Organization', name: experience[0].company },
      alumniOf: { '@type': 'CollegeOrUniversity', name: education[0].institution },
      knowsAbout: ['Flutter', 'Dart', 'Android', 'Firebase', 'Google Play', 'Mobile application development'],
      knowsLanguage: ['mr', 'hi', 'en'],
      sameAs: socials.map((s) => s.href),
    },
    {
      // ProfessionalService is a LocalBusiness subtype, used here for freelance work.
      '@type': 'ProfessionalService',
      '@id': id.service,
      name: `${profile.name}, Flutter App Development`,
      description: `Freelance Android app development in Flutter by ${profile.name}, from the first screen to the Google Play release.`,
      url: abs('/'),
      image: ogImage,
      logo: abs('/apple-touch-icon.png'),
      email: profile.email,
      address,
      areaServed: [
        { '@type': 'City', name: 'Palghar' },
        { '@type': 'State', name: 'Maharashtra' },
        { '@type': 'Country', name: 'India' },
      ],
      founder: { '@id': id.person },
      knowsAbout: ['Flutter', 'Android apps', 'Firebase', 'Google Play publishing'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: [
          'Android app development in Flutter',
          'Google Play Store release and maintenance',
          'Firebase and REST API integration',
        ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
      },
    },
  );
}

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="theme-color" content="#181A20" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={noindex ? 'website' : 'profile'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_IN" />
    {!noindex && <meta property="profile:first_name" content={profile.name.split(' ')[0]} />}
    {!noindex && <meta property="profile:last_name" content={profile.name.split(' ').at(-1)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        window.__motionFallback = setTimeout(function () {
          d.classList.add('motion-ready-fallback');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

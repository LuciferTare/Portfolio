---
import Icon from './Icon.astro';
import { nav, profile, socials } from '../data/portfolio';
---

<a href="#main" class="skip">Skip to content</a>
<div class="nav-sentinel" aria-hidden="true"></div>

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="#top" class="mark" aria-label={`${profile.name}, back to top`}>
      <span class="mark-glyph mono" aria-hidden="true">{profile.initials}</span>
      <span class="mark-name">{profile.name}</span>
    </a>

    <nav aria-label="Primary" class="nav-desktop">
      <ul class="nav-list" data-nav-list>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link" data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
    </nav>

    <div class="nav-actions">
      <a
        href={profile.cv.href}
        target="_blank"
        rel="noopener"
        class="btn nav-cv"
        aria-label="Open CV (PDF, opens in a new tab)"
      >
        {profile.cv.label}
        <Icon name="arrow-up-right" />
      </a>
      <button type="button" class="menu-btn" data-menu-open aria-haspopup="dialog" aria-controls="mobile-menu">
        <Icon name="list" size="22" />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="menu" aria-label="Menu" data-menu>
  <div class="menu-inner">
    <div class="menu-top">
      <span class="mark">
        <span class="mark-glyph mono" aria-hidden="true">{profile.initials}</span>
        <span class="mark-name">{profile.name}</span>
      </span>
      <button type="button" class="menu-btn" data-menu-close>
        <Icon name="x" size="22" />
        <span class="sr-only">Close menu</span>
      </button>
    </div>

    <nav aria-label="Mobile">
      <ul class="menu-list">
        {
          nav.map((item) => (
            <li data-menu-item>
              <a href={item.href} class="menu-link" data-menu-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-foot" data-menu-item>
      <a href={profile.cv.href} target="_blank" rel="noopener" class="btn btn-primary">
        Open CV <Icon name="arrow-up-right" />
      </a>
      <ul class="menu-socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="menu-social">
                <Icon name={s.kind} size="20" />
                <span class="sr-only">{s.label} (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<style>
  .skip {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: var(--z-skip);
    padding: 0.6rem 1rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-ui);
    font-weight: 600;
    translate: 0 -200%;
    transition: translate 0.2s var(--ease-out);
  }
  .skip:focus-visible {
    translate: 0 0;
  }

  .nav-sentinel {
    position: absolute;
    top: 0;
    height: 8px;
    width: 1px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: var(--nav-h);
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--color-line);
  }
  @media (prefers-reduced-transparency: reduce) {
    .nav {
      background: var(--color-bg);
      backdrop-filter: none;
    }
  }

  .nav-inner {
    height: 100%;
    padding-inline: var(--nav-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-fg);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .mark-glyph {
    display: grid;
    place-items: center;
    width: var(--nav-item);
    height: var(--nav-item);
    border-radius: var(--radius-ui);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .nav-desktop {
    position: relative;
    display: none;
    margin-left: auto;
  }
  .nav-list {
    display: flex;
    gap: 0.25rem;
  }
  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--color-fg-2);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover,
  .nav-link[aria-current='true'] {
    color: var(--color-fg);
  }
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: -13px;
    width: 100px;
    height: 1px;
    background: var(--color-accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
    opacity: 0;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-cv {
    height: var(--nav-item);
    padding-inline: 0.9rem;
    font-size: 0.875rem;
  }

  .menu-btn {
    display: grid;
    place-items: center;
    width: var(--nav-item);
    height: var(--nav-item);
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-ui);
    background: transparent;
    color: var(--color-fg);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: block;
    }
    .menu-btn {
      display: none;
    }
  }
  @media (max-width: 479px) {
    .nav-cv {
      display: none;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-fg);
    z-index: var(--z-menu);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: 2rem;
  }
  .menu-inner > :not(.menu-top) {
    padding-inline: var(--gutter);
  }
  .menu-top {
    height: var(--nav-h);
    padding-inline: var(--nav-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-list {
    margin-top: 2.5rem;
    display: grid;
  }
  .menu-link {
    display: block;
    padding: 0.55rem 0;
    font-size: clamp(2.25rem, 10vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--color-fg);
    text-decoration: none;
  }
  .menu-link:hover {
    color: var(--color-accent);
  }
  .menu-foot {
    margin-top: auto;
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .menu-socials {
    display: flex;
    gap: 0.5rem;
  }
  .menu-social {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-ui);
    color: var(--color-fg);
  }
</style>

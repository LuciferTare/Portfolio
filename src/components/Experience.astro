---
import { experience } from '../data/portfolio';
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container-x">
    <h2 id="experience-title" class="h-section" data-reveal>Current Role</h2>

    {
      experience.map((job, i) => (
        <article class="job" aria-labelledby={`job-${i}`} data-reveal>
          <div class="job-side">
            <p class="meta job-dates">
              <time>{job.start}</time> - <time>{job.end}</time>
            </p>
            <dl class="job-facts">
              {job.facts.map((f) => (
                <div class="fact">
                  <dt class="meta">{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="job-main">
            <h3 class="job-role" id={`job-${i}`}>
              {job.role}
            </h3>
            <p class="job-company">{job.company}</p>
            <p class="job-summary">{job.summary}</p>
            <h4 class="meta job-duties-title">What I do</h4>
            <ul class="job-duties">
              {job.duties.map((d) => <li>{d}</li>)}
            </ul>
            <a href={job.caseStudy.href} class="link link-rest job-link">
              {job.caseStudy.label}
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .job {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
    display: grid;
    gap: 1.75rem;
  }
  .job-dates {
    color: var(--color-accent);
  }
  .job-facts {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1rem 1.5rem;
    margin-top: 0;
  }
  .fact dd {
    margin-top: 0.2rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .job-role {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.03em;
  }
  .job-company {
    margin-top: 0.35rem;
    color: var(--color-fg-2);
  }
  .job-summary {
    margin-top: 0;
    max-width: 62ch;
  }
  .job-duties-title {
    margin-top: 1.75rem;
  }
  .job-duties {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.75rem;
    max-width: 62ch;
    color: var(--color-fg-2);
  }
  .job-duties li {
    position: relative;
    padding-left: 1.25rem;
  }
  .job-duties li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-accent);
  }
  .job-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }

  @media (min-width: 1024px) {
    .job {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4rem;
    }
    .job-facts {
      grid-auto-flow: row;
      grid-template-columns: minmax(0, 1fr);
      max-width: 16rem;
    }
  }
</style>

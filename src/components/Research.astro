---
import Icon from "./Icon.astro";
import { publications } from "../data/portfolio";

const me = /Tare/;
const projectAnchor: Record<string, string> = {
  octanet: "OctaNet",
  cravecoin: "Cravecoin",
  quantaview: "Quantaview",
  towzer: "Towzer",
  fitfuel: "Fit&Fuel",
};
---

<section id="research" class="section" aria-labelledby="research-title">
  <div class="container-x">
    <h2 id="research-title" class="h-section" data-reveal>Research</h2>
    <p class="prose-body research-intro" data-reveal>
      I've published 5 papers, each about an app I've worked on, from the
      problem it solves to how it's built.
    </p>

    <ol class="pubs" reversed>
      {
        publications.map((p) => {
          const paper = p.links.find((l) => l.label.includes("Paper"));
          const extra = p.links.filter((l) => l !== paper);
          const rel = (href: string) =>
            href.startsWith("http") ? "noopener noreferrer" : "noopener";
          return (
            <li class="pub" data-reveal>
              <article class="pub-main" aria-labelledby={`pub-${p.id}`}>
                <h3 class="pub-title" id={`pub-${p.id}`}>
                  <cite>
                    {p.title}
                    {p.subtitle && <span class="pub-sub">: {p.subtitle}</span>}
                  </cite>
                </h3>
                <p class="pub-venue">
                  <em>{p.venue}</em>,{" "}
                  <span class="mono pub-year">{p.year}</span>
                </p>
                {p.context && <p class="pub-context">{p.context}</p>}

                <div class="pub-actions">
                  {paper && (
                    <a
                      href={paper.href}
                      class="pub-link"
                      target="_blank"
                      rel={rel(paper.href)}
                    >
                      <Icon name="pdf" size="16" />
                      Paper
                      <span class="sr-only">
                        , {p.title}, PDF (opens in a new tab)
                      </span>
                    </a>
                  )}
                  <button
                    type="button"
                    class="pub-toggle"
                    data-disclosure
                    aria-expanded="false"
                    aria-controls={`pub-${p.id}-details`}
                  >
                    Details<span class="sr-only"> for {p.title}</span>
                    <Icon name="arrow-down" size="14" />
                  </button>
                </div>

                <div class="pub-panel" id={`pub-${p.id}-details`} hidden>
                  <p class="meta">{p.kind}</p>
                  <p class="pub-authors">
                    {p.authors.map((a, i) => (
                      <>
                        {i > 0 && (i === p.authors.length - 1 ? " and " : ", ")}
                        {me.test(a) ? <strong>{a}</strong> : a}
                      </>
                    ))}
                  </p>
                  <p class="meta pub-details">
                    {[...p.details, p.date].join("  /  ")}
                  </p>
                  {p.note && <p class="pub-note">{p.note}</p>}
                  <div class="pub-panel-actions">
                    {extra.map((l) => (
                      <a
                        href={l.href}
                        class="pub-link"
                        target="_blank"
                        rel={rel(l.href)}
                      >
                        <Icon
                          name={
                            l.href.startsWith("http") ? "arrow-up-right" : "pdf"
                          }
                          size="16"
                        />
                        {l.label}
                        <span class="sr-only">
                          , {p.title}
                          {l.description ? `, ${l.description}` : ""} (opens in
                          a new tab)
                        </span>
                      </a>
                    ))}
                    <button
                      type="button"
                      class="pub-link"
                      data-copy={p.citation}
                      data-copy-label="Citation copied"
                    >
                      <Icon name="quotes" size="16" />
                      <span data-copy-text>Copy Citation</span>
                      <span class="sr-only">for {p.title}</span>
                    </button>
                    {p.project && (
                      <a
                        href={`#project-${p.project}`}
                        class="pub-link pub-project"
                      >
                        Project: {projectAnchor[p.project]}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </div>
</section>

<style>
  .research-intro {
    margin-top: 1.25rem;
  }

  .pubs {
    margin-top: clamp(2rem, 4vw, 3rem);
    list-style: none;
    display: grid;
  }
  .pub {
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-line);
  }
  .pub-title {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .pub-title cite {
    font-style: normal;
  }
  .pub-sub {
    color: var(--color-fg-2);
    font-weight: 500;
  }
  .pub-venue {
    margin-top: 0.3rem;
    font-size: 0.925rem;
    color: var(--color-fg-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pub-year {
    color: var(--color-fg-3);
  }
  .pub-context {
    margin-top: 0.3rem;
    font-size: 0.925rem;
  }
  .pub-actions {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.25rem;
    padding-inline: 0.8rem;
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-ui);
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .pub-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pub-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-fg-2);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .pub-toggle:hover {
    color: var(--color-accent);
  }
  .pub-toggle :global(svg) {
    transition: transform 0.2s;
  }
  .pub-toggle[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }
  .pub-panel {
    margin-top: 1rem;
    padding: 1rem 0 0.25rem 1rem;
    border-left: 1px solid var(--color-line-2);
  }
  .pub-authors {
    margin-top: 0.4rem;
    font-size: 0.925rem;
    color: var(--color-fg-2);
  }
  .pub-authors strong {
    color: var(--color-fg);
    font-weight: 600;
  }
  .pub-details {
    margin-top: 0.4rem;
    white-space: pre-wrap;
  }
  .pub-note {
    margin-top: 0.75rem;
    font-size: 0.925rem;
    color: var(--color-fg-2);
    max-width: 62ch;
  }
  .pub-panel-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pub-project {
    border-style: dashed;
    color: var(--color-fg-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .pub-toggle :global(svg) {
      transition: none;
    }
  }
</style>

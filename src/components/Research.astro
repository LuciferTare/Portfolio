---
import Icon from './Icon.astro';
import { publications, recognition } from '../data/portfolio';

const me = /Tare/;
const projectAnchor: Record<string, string> = {
  octanet: 'OctaNet',
  cravecoin: 'Cravecoin',
  quantaview: 'Quantaview',
  towzer: 'Towzer',
  fitfuel: 'Fit&Fuel',
};
---

<section id="research" class="section" aria-labelledby="research-title">
  <div class="container-x">
    <h2 id="research-title" class="h-section" data-reveal>Published Papers</h2>
    <p class="prose-body research-intro" data-reveal>
      I’ve published 5 papers, each about an app I’ve worked on, from the problem it solves to how it’s built.
    </p>

    <aside class="award" aria-labelledby="award-title" data-reveal>
      <div class="award-figure mono" aria-hidden="true">
        <span class="award-n" data-count={recognition.finalists} data-count-from="999">{recognition.finalists}</span>
        <span class="award-of">of ~{recognition.entries.toLocaleString('en-IN')}</span>
      </div>
      <div class="award-body">
        <p class="meta">{recognition.date}</p>
        <h3 id="award-title" class="award-title">{recognition.title}</h3>
        <p class="award-text">{recognition.body}</p>
        <a href="#project-cravecoin" class="link link-rest award-link">See Cravecoin Project</a>
      </div>
    </aside>

    <ol class="pubs" reversed>
      {
        publications.map((p) => (
          <li class="pub" data-reveal>
            <p class="pub-year mono">{p.year}</p>
            <article class="pub-main" aria-labelledby={`pub-${p.id}`}>
              <p class="meta pub-kind">{p.kind}</p>
              <h3 class="pub-title" id={`pub-${p.id}`}>
                <cite>
                  {p.title}
                  {p.subtitle && <span class="pub-sub">: {p.subtitle}</span>}
                </cite>
              </h3>
              <p class="pub-authors">
                {p.authors.map((a, i) => (
                  <>
                    {i > 0 && (i === p.authors.length - 1 ? ' and ' : ', ')}
                    {me.test(a) ? <strong>{a}</strong> : a}
                  </>
                ))}
                {p.authorsNote && <span class="pub-authors-note">, {p.authorsNote}</span>}
              </p>
              <p class="pub-venue">
                <em>{p.venue}</em>
              </p>
              <p class="meta pub-details">
                {[...p.details, p.date].join('  /  ')}
              </p>
              {p.note && <p class="pub-note">{p.note}</p>}

              <div class="pub-actions">
                {p.links.map((l) => {
                  const external = l.href.startsWith('http');
                  return (
                    <a
                      href={l.href}
                      class="pub-link"
                      target="_blank"
                      rel={external ? 'noopener noreferrer' : 'noopener'}
                    >
                      <Icon name={external ? 'arrow-up-right' : 'pdf'} size="16" />
                      {l.label}
                      <span class="sr-only">
                        , {p.title}
                        {l.description ? `, ${l.description}` : ''} (opens in a new tab)
                      </span>
                    </a>
                  );
                })}
                <button type="button" class="pub-link" data-copy={p.citation} data-copy-label="Citation copied">
                  <Icon name="quotes" size="16" />
                  <span data-copy-text>Copy Citation</span>
                  <span class="sr-only">for {p.title}</span>
                </button>
                {p.project && (
                  <a href={`#project-${p.project}`} class="pub-link pub-project">
                    Project: {projectAnchor[p.project]}
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </div>
</section>

<style>
  .research-intro {
    margin-top: 1.25rem;
  }

  .award {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-ui);
    background:
      linear-gradient(90deg, rgb(252 213 53 / 0.07), transparent 55%),
      var(--color-bg-2);
  }
  .award-figure {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .award-n {
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .award-of {
    font-size: clamp(1rem, 2vw, 1.35rem);
    color: var(--color-fg-2);
  }
  .award-title {
    margin-top: 0.4rem;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    letter-spacing: -0.03em;
  }
  .award-text {
    margin-top: 0.6rem;
    color: var(--color-fg-2);
    max-width: 56ch;
  }
  .award-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.925rem;
  }

  .pubs {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    list-style: none;
    display: grid;
  }
  .pub {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-line);
  }
  .pub-year {
    font-size: 0.9rem;
    color: var(--color-fg-3);
  }
  .pub-title {
    margin-top: 0.5rem;
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .pub-title cite {
    font-style: normal;
  }
  .pub-sub {
    color: var(--color-fg-2);
    font-weight: 500;
  }
  .pub-authors {
    margin-top: 0.75rem;
    color: var(--color-fg-2);
  }
  .pub-authors strong {
    color: var(--color-fg);
    font-weight: 600;
  }
  .pub-venue {
    margin-top: 0.15rem;
    color: var(--color-fg-2);
  }
  .pub-details {
    margin-top: 0.6rem;
    white-space: pre-wrap;
  }
  .pub-note {
    margin-top: 0.9rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-accent);
    font-size: 0.925rem;
    color: var(--color-fg-2);
    max-width: 62ch;
  }
  .pub-actions {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.25rem;
    padding-inline: 0.8rem;
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-ui);
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .pub-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pub-project {
    border-style: dashed;
    color: var(--color-fg-2);
  }

  @media (min-width: 768px) {
    .award {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }
    .pub {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 2rem;
      padding: 2.5rem 0;
    }
    .pub-year {
      padding-top: 0.2rem;
    }
  }
</style>
